generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String?        @map("password_hash")
  googleId      String?        @unique @map("google_id")
  emailVerified Boolean?       @default(false) @map("email_verified")
  displayName   String         @map("display_name")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastLoginAt   DateTime?      @map("last_login_at")
  profile       Profile?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedGroups   Group[]        @relation("GroupOwner")
  groupMembers  GroupMember[]
  pomodoroSessions PomodoroSession[]
  achievements  UserAchievement?
  resources     Resource[]     @relation("ResourceOwner")
  resourceAccesses ResourceAccess[]
  readNotifications UserNotificationRead[]
  suggestions   Suggestion[]
  dhikrSubmissions DhikrSubmission[]
  targetedNotifications AppNotification[] @relation("AppNotificationTarget")

  @@map("users")
}

model Suggestion {
  id        String   @id @default(uuid())
  title     String
  content   String
  anonymous Boolean  @default(false) @map("anonymous")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("suggestions")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  bio       String?
  avatarUrl String?  @map("avatar_url")
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserAchievement {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  completedTasks    Int      @default(0) @map("completed_tasks")
  cardsReviewed     Int      @default(0) @map("cards_reviewed")
  completedSessions Int      @default(0) @map("completed_sessions")
  meaningfulNotes   Int      @default(0) @map("meaningful_notes")
  files             Int      @default(0)
  flashcards        Int      @default(0)
  quizzesCompleted  Int      @default(0) @map("quizzes_completed")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_achievements")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum Role {
  USER
  ADMIN
}

enum AppNotificationType {
  info
  announcement
  update
}

enum DhikrSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AppNotification {
  id           String                @id @default(uuid())
  title        String
  body         String
  type         AppNotificationType   @default(info)
  createdBy    String?               @map("created_by")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  // When set, the notification is delivered ONLY to this user (used for
  // per-user messages such as dhikr rejection). NULL keeps the notification
  // global (broadcast) — the previous behaviour.
  targetUserId String?               @map("target_user_id")
  // Cascade so a personal/targeted notification is removed together with its
  // recipient's account — a SetNull would silently turn it into a broadcast.
  targetUser   User?                 @relation("AppNotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  userReads    UserNotificationRead[]

  @@index([createdAt])
  @@index([targetUserId])
  @@map("app_notifications")
}

model DhikrSubmission {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  categoryId String                @map("category_id")
  title      String
  text       String
  source     String                @default("")
  status     DhikrSubmissionStatus @default(PENDING)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("dhikr_submissions")
}

model DhikrOfficialEdit {
  id              String   @id @default(uuid())
  officialDhikrId String   @unique @map("official_dhikr_id")
  title           String
  text            String
  source          String   @default("")
  editedBy        String   @map("edited_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dhikr_official_edits")
}

model DhikrOfficialDeletion {
  id              String   @id @default(uuid())
  officialDhikrId String   @unique @map("official_dhikr_id")
  deletedBy       String   @map("deleted_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("dhikr_official_deletions")
}

model UserNotificationRead {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  notificationId String          @map("notification_id")
  readAt         DateTime        @default(now()) @map("read_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([notificationId])
  @@map("user_notification_reads")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum ResourceType {
  FILE
  NOTE
  LINK
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  joinCode    String        @unique @map("join_code")
  creatorId   String        @map("creator_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  creator     User          @relation("GroupOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  pomodoroSessions PomodoroSession[]

  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now()) @map("created_at")
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model PomodoroSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  groupId         String   @map("group_id")
  durationSeconds Int      @map("duration_seconds")
  completedAt     DateTime @default(now()) @map("completed_at")
  sessionId       String   @unique @map("session_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId, groupId])
  @@index([groupId, completedAt])
  @@map("pomodoro_sessions")
}

model Resource {
  id                   String          @id @default(uuid())
  title                String
  description          String?
  type                 ResourceType
  ownerId              String          @map("owner_id")
  // Privacy: PUBLIC (false) resources behave exactly as before. PRIVATE (true)
  // resources are hidden from other users until they prove ownership of the
  // resource's 6-digit access code. The code is never stored in plain text:
  // a SHA-256 hash guarantees uniqueness (active-code collisions) and enables
  // constant-time validation, while an AES-256-GCM ciphertext lets the owner
  // view/copy their code again later.
  isPrivate            Boolean         @default(false) @map("is_private")
  accessCodeHash       String?         @unique @map("access_code_hash")
  accessCodeCiphertext String?         @map("access_code_ciphertext")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  owner                User            @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  access               ResourceAccess[]
  files                ResourceFile[]
  notes                ResourceNote[]
  links                ResourceLink[]

  @@index([ownerId])
  @@map("resources")
}

model ResourceAccess {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([userId])
  @@map("resource_accesses")
}

model ResourceFile {
  id          String   @id @default(uuid())
  resourceId  String   @map("resource_id")
  name        String
  mimeType    String   @map("mime_type")
  size        Int
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_files")
}

model ResourceNote {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  title      String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_notes")
}

model ResourceLink {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  title      String
  url        String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_links")
}
