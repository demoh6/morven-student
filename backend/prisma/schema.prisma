generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  passwordHash  String?        @map("password_hash")
  googleId      String?        @unique @map("google_id")
  emailVerified Boolean?       @default(false) @map("email_verified")
  displayName   String         @map("display_name")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  lastLoginAt   DateTime?      @map("last_login_at")
  profile       Profile?
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ownedGroups   Group[]        @relation("GroupOwner")
  groupMembers  GroupMember[]
  pomodoroSessions PomodoroSession[]
  achievements  UserAchievement?
  resources     Resource[]     @relation("ResourceOwner")
  resourceAccesses ResourceAccess[]
  readNotifications UserNotificationRead[]
  suggestions   Suggestion[]
  dhikrSubmissions DhikrSubmission[]
  targetedNotifications AppNotification[] @relation("AppNotificationTarget")
  tasks         Task[]
  exams         Exam[]
  flashcards    Flashcard[]
  notes         Note[]
  userFiles     UserFile[]
  pomodoroStats PomodoroStats?
  adhkarProgress AdhkarProgress[]
  userPreference UserPreference?

  @@map("users")
}

model Suggestion {
  id        String   @id @default(uuid())
  title     String
  content   String
  anonymous Boolean  @default(false) @map("anonymous")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("suggestions")
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  bio       String?
  avatarUrl String?  @map("avatar_url")
  isPublic  Boolean  @default(true) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserAchievement {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  completedTasks    Int      @default(0) @map("completed_tasks")
  cardsReviewed     Int      @default(0) @map("cards_reviewed")
  completedSessions Int      @default(0) @map("completed_sessions")
  meaningfulNotes   Int      @default(0) @map("meaningful_notes")
  files             Int      @default(0)
  flashcards        Int      @default(0)
  quizzesCompleted  Int      @default(0) @map("quizzes_completed")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_achievements")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum Role {
  USER
  SUB_ADMIN
  ADMIN
}

enum AppNotificationType {
  info
  announcement
  update
}

enum DhikrSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AppNotification {
  id           String                @id @default(uuid())
  title        String
  body         String
  type         AppNotificationType   @default(info)
  createdBy    String?               @map("created_by")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  // When set, the notification is delivered ONLY to this user (used for
  // per-user messages such as dhikr rejection). NULL keeps the notification
  // global (broadcast) — the previous behaviour.
  targetUserId String?               @map("target_user_id")
  // Cascade so a personal/targeted notification is removed together with its
  // recipient's account — a SetNull would silently turn it into a broadcast.
  targetUser   User?                 @relation("AppNotificationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  userReads    UserNotificationRead[]

  @@index([createdAt])
  @@index([targetUserId])
  @@map("app_notifications")
}

model DhikrSubmission {
  id         String                @id @default(uuid())
  userId     String                @map("user_id")
  categoryId String                @map("category_id")
  title      String
  text       String
  source     String                @default("")
  status     DhikrSubmissionStatus @default(PENDING)
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("dhikr_submissions")
}

model DhikrOfficialEdit {
  id              String   @id @default(uuid())
  officialDhikrId String   @unique @map("official_dhikr_id")
  title           String
  text            String
  source          String   @default("")
  editedBy        String   @map("edited_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("dhikr_official_edits")
}

model DhikrOfficialDeletion {
  id              String   @id @default(uuid())
  officialDhikrId String   @unique @map("official_dhikr_id")
  deletedBy       String   @map("deleted_by")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("dhikr_official_deletions")
}

model UserNotificationRead {
  id             String          @id @default(uuid())
  userId         String          @map("user_id")
  notificationId String          @map("notification_id")
  readAt         DateTime        @default(now()) @map("read_at")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([notificationId])
  @@map("user_notification_reads")
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum ResourceType {
  FILE
  NOTE
  LINK
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  imageUrl    String?       @map("image_url")
  joinCode    String        @unique @map("join_code")
  creatorId   String        @map("creator_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  creator     User          @relation("GroupOwner", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  pomodoroSessions PomodoroSession[]

  @@map("groups")
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String    @map("group_id")
  userId    String    @map("user_id")
  role      GroupRole @default(MEMBER)
  createdAt DateTime  @default(now()) @map("created_at")
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model PomodoroSession {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  groupId         String   @map("group_id")
  durationSeconds Int      @map("duration_seconds")
  completedAt     DateTime @default(now()) @map("completed_at")
  sessionId       String   @unique @map("session_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([userId, groupId])
  @@index([groupId, completedAt])
  @@map("pomodoro_sessions")
}

model Resource {
  id                   String          @id @default(uuid())
  title                String
  description          String?
  type                 ResourceType
  ownerId              String          @map("owner_id")
  // Privacy: PUBLIC (false) resources behave exactly as before. PRIVATE (true)
  // resources are hidden from other users until they prove ownership of the
  // resource's 6-digit access code. The code is never stored in plain text:
  // a SHA-256 hash guarantees uniqueness (active-code collisions) and enables
  // constant-time validation, while an AES-256-GCM ciphertext lets the owner
  // view/copy their code again later.
  isPrivate            Boolean         @default(false) @map("is_private")
  accessCodeHash       String?         @unique @map("access_code_hash")
  accessCodeCiphertext String?         @map("access_code_ciphertext")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  owner                User            @relation("ResourceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  access               ResourceAccess[]
  files                ResourceFile[]
  notes                ResourceNote[]
  links                ResourceLink[]

  @@index([ownerId])
  @@map("resources")
}

model ResourceAccess {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  userId     String   @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
  @@index([userId])
  @@map("resource_accesses")
}

model ResourceFile {
  id          String   @id @default(uuid())
  resourceId  String   @map("resource_id")
  name        String
  mimeType    String   @map("mime_type")
  size        Int
  storagePath String   @map("storage_path")
  createdAt   DateTime @default(now()) @map("created_at")
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_files")
}

model ResourceNote {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  title      String
  content    String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_notes")
}

model ResourceLink {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  title      String
  url        String
  createdAt  DateTime @default(now()) @map("created_at")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@map("resource_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// Account-scoped user models (Phase 1)
//
// These models back the features that were previously local-only (browser
// localStorage / IndexedDB) and give every record a required, cascading owner
// relationship to User. Rows are created by the authenticated user only and
// filter queries by userId.
// ─────────────────────────────────────────────────────────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskType {
  NORMAL
  DAILY
}

enum NoteType {
  GENERAL
  MEDICAL
}

enum FlashcardType {
  GENERAL
  MEDICAL
}

enum FlashcardDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PomodoroTheme {
  CLASSIC
  DIGITAL
  NATURE
}

enum PomodoroTimerMode {
  COUNTDOWN
  COUNTUP
}

model Task {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  title       String
  description String?
  completed   Boolean      @default(false)
  priority    TaskPriority @default(MEDIUM)
  // Local calendar date string ("YYYY-MM-DD"), matching the frontend Task shape.
  dueDate     String?      @map("due_date")
  taskType    TaskType     @default(NORMAL) @map("task_type")
  // Local clock time string ("HH:mm") for daily recurring tasks.
  dailyTime   String?      @map("daily_time")
  // Stable client-generated id for idempotent guest→account migration.
  clientId    String?      @map("client_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, clientId])
  @@map("tasks")
}

model Exam {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  // Target date string ("YYYY-MM-DD"), matching the frontend ExamCountdown shape.
  date      String
  color     String
  // Stable client-generated id for idempotent guest→account migration.
  clientId  String?      @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, clientId])
  @@map("exams")
}

model Flashcard {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  front       String
  back        String
  deck        String
  // Distinguishes the general flashcards bucket from the medical one so both
  // existing local stores can later be imported without losing that distinction.
  type        FlashcardType       @default(GENERAL)
  difficulty  FlashcardDifficulty @default(MEDIUM)
  // Epoch-ms value on the frontend ("nextReview") — stored as a timestamp.
  nextReview  DateTime?           @map("next_review")
  reviewCount Int                 @default(0) @map("review_count")
  // Stable client-generated id for idempotent guest→account migration.
  clientId    String?             @map("client_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, clientId])
  @@map("flashcards")
}

model Note {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String
  pinned    Boolean  @default(false)
  // GENERAL notes map to the "morven-notes" store, MEDICAL to "morven-medical-notes".
  type      NoteType @default(GENERAL)
  // Medical note category (free string). Null for general notes.
  category  String?
  // Stable client-generated id for idempotent guest→account migration.
  clientId  String?  @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, clientId])
  @@map("notes")
}

model UserFile {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  mimeType   String   @map("mime_type")
  size       Int
  // Future object-storage key/path. Metadata only in Phase 1 — blobs are NOT
  // stored on this table and are NOT placed under the public /uploads mount.
  storageKey String   @map("storage_key")
  toolUsed   String?  @map("tool_used")
  // Stable client-generated id for idempotent guest→account migration.
  clientId   String?  @map("client_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, clientId])
  @@map("user_files")
}

model PomodoroStats {
  id                String   @id @default(uuid())
  userId            String   @unique @map("user_id")
  completedSessions Int      @default(0) @map("completed_sessions")
  totalFocusSeconds Int      @default(0) @map("total_focus_seconds")
  lastFocusSeconds  Int      @default(0) @map("last_focus_seconds")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pomodoro_stats")
}

model AdhkarProgress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  // Local calendar date string ("YYYY-MM-DD").
  day       String
  // Per-dhikr counter map (dhikr id -> count) for the day, matching the
  // frontend Adhkar store shape { counts, day }. JSON is used because the set
  // of dhikr keys is dynamic (categories + user-approved submissions).
  counts    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("adhkar_progress")
}

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // UI theme: "light" | "dark" | "system".
  theme       String   @default("dark")
  recentTools String[] @default([]) @map("recent_tools")

  // Pomodoro settings (mirrors the frontend PomodoroSettings shape).
  pomodoroFocusMinutes           Int             @default(25) @map("pomodoro_focus_minutes")
  pomodoroBreakMinutes           Int             @default(5) @map("pomodoro_break_minutes")
  pomodoroLongBreakMinutes       Int             @default(15) @map("pomodoro_long_break_minutes")
  pomodoroSessionsUntilLongBreak Int             @default(4) @map("pomodoro_sessions_until_long_break")
  pomodoroTheme                  PomodoroTheme   @default(CLASSIC) @map("pomodoro_theme")
  pomodoroTimerMode              PomodoroTimerMode @default(COUNTDOWN) @map("pomodoro_timer_mode")

  // Adhkar reminder slot state (local calendar date-key per slot, nullable).
  adhkarReminderShownMorning     String? @map("adhkar_reminder_shown_morning")
  adhkarReminderDismissedMorning String? @map("adhkar_reminder_dismissed_morning")
  adhkarReminderShownEvening     String? @map("adhkar_reminder_shown_evening")
  adhkarReminderDismissedEvening String? @map("adhkar_reminder_dismissed_evening")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
